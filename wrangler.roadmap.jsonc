{
  // Deploys the interactive System Design Map as a static site on Cloudflare
  // Workers:
  //
  //   roadmap.mhayk.workers.dev/  -> index.html  (the map)
  //
  // An assets-only Worker — no "main" script, so Cloudflare simply serves the
  // directory. Same shape as the rate limiter's and the estimation configs;
  // the only differences are the name and the directory.
  //
  // IMPORTANT: this file is deliberately NOT named `wrangler.jsonc`. A bare
  // `npx wrangler deploy` auto-loads only `wrangler.jsonc` (the rate limiter's
  // config), so that build is untouched. To deploy THIS one, the command must
  // point at this file explicitly:
  //
  //   npx wrangler deploy --config wrangler.roadmap.jsonc
  //
  // "name" drives the *.workers.dev subdomain, so name the Cloudflare project
  // "roadmap" too, or the URL and the config will disagree.
  "name": "roadmap",
  "compatibility_date": "2026-07-21",
  "assets": {
    "directory": "./resources/roadmap"
  }
}
